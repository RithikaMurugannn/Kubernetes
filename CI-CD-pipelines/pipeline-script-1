pipeline {
    agent any

    stages {
        stage('git checkout') {
            steps {
                git branch: 'stateful-set', url: 'https://github.com/Msocial123/fss-Retail-App_kubernetes.git' // here do generate the pipeline script again
            }
        }
        
        stage('docker build, tag & push'){
            steps{
                script{
                    withDockerRegistry(credentialsId: 'docker-cred', toolName: 'docker') {
                      sh 'docker build -t fss-retail-app:v1.0.0 .'
                      sh 'docker tag fss-retail-app:v1.0.0 rithika17/fss-retail-app:v1.0.0'
                      sh 'docker push rithika17/fss-retail-app:v1.0.0'
                   }
                }
            }
        }
        stage('deploy to container') {
            steps{
                sh 'docker run -d --name retail-app -p 3130:3130 rithika17/fss-retail-app:v1.0.0'
            }
        }
    }
}


# For docker login failed error in jenkins pipeline, run below commands on jenkins VM only.
 
sudo usermod -aG docker jenkins
sudo systemctl restart jenkins